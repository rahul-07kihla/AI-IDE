generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectVisibility {
  PRIVATE
  TEAM
}

enum FileType {
  FILE
  DIRECTORY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String?
  role           UserRole       @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  projects       Project[]
  messages       Message[]
  usageLogs      UsageLog[]
  subscriptions  Subscription[]
  agentRuns      AgentRun[]
}

model Project {
  id              String            @id @default(cuid())
  ownerId         String
  name            String
  slug            String            @unique
  description     String?
  visibility      ProjectVisibility @default(PRIVATE)
  runtimeImage    String            @default("node:20-bookworm")
  rootPath        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files           ProjectFile[]
  messages        Message[]
  usageLogs       UsageLog[]
  agentRuns       AgentRun[]

  @@index([ownerId])
}

model ProjectFile {
  id          String    @id @default(cuid())
  projectId   String
  parentId    String?
  path        String
  name        String
  type        FileType
  extension   String?
  mimeType    String?
  content     String?
  sizeBytes   Int       @default(0)
  sha256      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      ProjectFile?  @relation("FileTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProjectFile[] @relation("FileTree")

  @@unique([projectId, path])
  @@index([projectId, parentId])
}

model Message {
  id              String      @id @default(cuid())
  userId          String?
  projectId       String
  role            MessageRole
  content         String
  toolCallsJson   Json?
  tokenInput      Int         @default(0)
  tokenOutput     Int         @default(0)
  createdAt       DateTime    @default(now())
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model UsageLog {
  id               String    @id @default(cuid())
  userId           String
  projectId        String?
  model            String?
  provider         String?
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  totalTokens      Int       @default(0)
  apiCostUsd       Decimal   @default(0) @db.Decimal(10, 5)
  executionMs      Int       @default(0)
  commandCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model Subscription {
  id                     String              @id @default(cuid())
  userId                 String
  plan                   SubscriptionPlan
  status                 SubscriptionStatus
  stripeCustomerId       String?             @unique
  stripeSubscriptionId   String?             @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AgentRun {
  id                String          @id @default(cuid())
  userId            String
  projectId         String
  status            AgentRunStatus  @default(QUEUED)
  objective         String
  planJson          Json?
  toolTraceJson     Json?
  patchJson         Json?
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, status])
}

